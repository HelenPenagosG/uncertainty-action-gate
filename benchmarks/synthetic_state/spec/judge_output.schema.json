{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent_compatibility", "intent_uncertainty", "evidence_level", "reason"],
  "properties": {
    "intent_compatibility": {"type": "number", "minimum": 0, "maximum": 1},
    "intent_uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_level": {
      "enum": ["EXPLICIT_RESTRICTION", "EXPLICIT_AUTHORIZATION", "OPERATOR_AUTHORIZATION", "CONTEXTUAL_INFERENCE", "INSUFFICIENT_EVIDENCE"]
    },
    "reason": {"type": "string", "minLength": 1, "maxLength": 300}
  }
}
